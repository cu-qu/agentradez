# Django
SECRET_KEY=dev-secret-key-change-me
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local

# Postgres (local Docker Compose defaults)
POSTGRES_DB=agentradez
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DJANGO_DB_NAME=agentradez
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=postgres
# Inside Docker / the Dev Container use the compose service name.
# On the host (no container) use localhost and port 5433.
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432
# Railway injects this. Locally you can leave it unset and use DJANGO_DB_*.
# DATABASE_URL=postgres://postgres:postgres@db:5432/agentradez

# Redis / Celery (compose service name inside Docker / Dev Container)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_DEFAULT_QUEUE=celery

# Hosts / CORS
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_DAYS=7

# Frontend links used in verification / password-reset emails
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_FRONTEND_PATH=/verify-email
EMAIL_VERIFICATION_SUBJECT=Agentradez: Confirm your email address
PASSWORD_RESET_FRONTEND_PATH=/reset-password
EMAIL_PASSWORD_RESET_SUBJECT=Reset your password

# Transactional email — django-anymail + Resend
# Without RESEND_API_KEY, Django uses the console email backend (prints to stdout).
# RESEND_API_KEY=re_...
DEFAULT_FROM_EMAIL=Agentradez <noreply@example.com>
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# EMAIL_USE_ANYMAIL_TAGS=true

# Seed admin (local + Railway setup_base_data). Never commit real credentials.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Copy Trade X (Twitter) watcher. Polling needs a v2 bearer token.
# How often to pull is set per source (poll_interval_seconds, default 60).
# Admin ingest/parse endpoints work without a token.
# X_PULLCALLS_API_CONSUMER_KEY=
# X_PULLCALLS_API_SECRET=
# X_PULLCALLS_BEARER_TOKEN=
# X_API_BASE_URL=https://api.x.com/2
# X_COPY_TRADE_HANDLE=some_trader

# Research / Breakthrough polls Google News RSS for each watched company.
# No extra API key. Poll interval is per strategy (research_config.poll_interval_seconds).

# Robinhood Agentic Trading MCP (OAuth). Robinhood only completes OAuth for a
# localhost callback. Production web apps paste that URL into
# POST /api/broker-connections/robinhood/oauth/complete/. HTTPS redirect URIs
# are ignored.
# ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# ROBINHOOD_CLIENT_ID=
# ROBINHOOD_OAUTH_REDIRECT_URI=http://localhost:8001/api/broker-connections/robinhood/oauth/callback/
# PUBLIC_API_URL=http://localhost:8001

# Stripe subscriptions (free is local; monthly/yearly use Checkout).
# Create a Product with two recurring Prices in Stripe, then paste the price IDs.
# Webhook endpoint: POST /api/billing/webhooks/stripe/
# Grant a friend access without Stripe:
#   python manage.py grant_subscription friend@example.com --plan yearly
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# STRIPE_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
# STRIPE_PORTAL_RETURN_URL=http://localhost:3000/billing

# Railway (set on gunicorn api / celery worker / celery beat)
# Source of truth: .railway/railway.ts  —  apply with: railway config apply
# ---------------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.production
# DEBUG=false
# ALLOWED_HOSTS=<your-service>.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://<your-service>.up.railway.app
# CORS_ALLOWED_ORIGINS=https://agentradez.com
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
# CELERY_BROKER_URL=${{Redis.REDIS_URL}}
# CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}
# FRONTEND_URL=https://agentradez.com
# DEFAULT_FROM_EMAIL=Agentradez <noreply@example.com>
# RESEND_API_KEY=
# ADMIN_USERNAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=
#
# Stage environment (same repo, second Railway environment):
# DJANGO_SETTINGS_MODULE=config.settings.stage
