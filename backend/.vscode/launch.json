{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: runserver",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "0.0.0.0:8000"],
      "django": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "DJANGO_SETTINGS_MODULE": "config.settings.local",
        "DJANGO_DB_HOST": "db",
        "DJANGO_DB_PORT": "5432",
        "REDIS_URL": "redis://redis:6379/0",
        "CELERY_BROKER_URL": "redis://redis:6379/0",
        "CELERY_RESULT_BACKEND": "redis://redis:6379/0"
      }
    },
    {
      "name": "Celery: worker",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": ["-A", "config", "worker", "-Q", "main,celery", "-l", "info"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "DJANGO_SETTINGS_MODULE": "config.settings.local",
        "DJANGO_DB_HOST": "db",
        "DJANGO_DB_PORT": "5432",
        "REDIS_URL": "redis://redis:6379/0",
        "CELERY_BROKER_URL": "redis://redis:6379/0",
        "CELERY_RESULT_BACKEND": "redis://redis:6379/0"
      }
    },
    {
      "name": "Celery: beat",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": ["-A", "config", "beat", "-l", "info"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "DJANGO_SETTINGS_MODULE": "config.settings.local",
        "DJANGO_DB_HOST": "db",
        "DJANGO_DB_PORT": "5432",
        "REDIS_URL": "redis://redis:6379/0",
        "CELERY_BROKER_URL": "redis://redis:6379/0",
        "CELERY_RESULT_BACKEND": "redis://redis:6379/0"
      }
    }
  ],
  "compounds": [
    {
      "name": "Agentradez: API + Celery",
      "configurations": ["Django: runserver", "Celery: worker", "Celery: beat"],
      "stopAll": true
    }
  ]
}
